    {
      "script_id": "argent-speaker-recover-leading-attribution",
      "name": "VELLUM Compact · Speaker Tags · Recover Name Before Quote",
      "folder": "ARGENT LOOM",
      "description": "Response-stage safety net: wraps otherwise bare single-line dialogue when an explicit proper-name attribution precedes it. Never guesses a speaker.",
      "find_regex": "{{if::{{and::{{var::dialogue_color}}::{{or::{{eq::{{var::reasoning_route}}::compact}}::{{eq::{{var::reasoning_route}}::verbose}}::{{eq::{{var::reasoning_route}}::native}}::{{eq::{{var::reasoning_route}}::silent}}}}}}}}^([ \\t]*)((?!(?:She|He|They|It|We|I|You|The|A|An|This|That|These|Those)\\b)[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’.-]*(?:[ \\t]+(?:(?:de|del|van|von|da|di|la|le|al|bin)[ \\t]+)?[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’.-]*){0,3})([ \\t]+(?:said|says|asked|asks|replied|replies|answered|answers|whispered|whispers|murmured|murmurs|called|calls|shouted|shouts|yelled|yells|cried|cries|added|adds|warned|warns|insisted|insists|admitted|admits|promised|promises|ordered|orders|demanded|demands|observed|observes|remarked|remarks|continued|continues)(?:[ \\t]+[a-z]+ly)?[ \\t]*[,—:-][ \\t]*)(?!\\[\\s*spk\\b)([\"“][^\"“”\\r\\n]{1,1200}[\"”]){{else}}(?!){{/if}}",
      "replace_string": "$1$2$3[spk=$2]$4[/spk]",
      "actions": [],
      "flags": "gm",
      "placement": [
        "ai_output"
      ],
      "scope": "global",
      "scope_id": null,
      "target": [
