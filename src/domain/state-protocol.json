      "parallel": { "ownership": "snapshot", "omission": "preserve-durable-projection", "identity": "actor-or-source-subplot-id", "evidence": "canon-and-feasibility" },
      "offscreen": { "ownership": "mutation", "omission": "no-change", "identity": "stable-id", "evidence": "semantic-grounding-and-mode" }
