      "validateCanon": true,
      "validateChronology": true,
      "validateCausality": true,
      "validateIdentity": true
    },
    "none": {
      "providerEvidenceFields": "omit",
      "requireEvidence": false,
      "validateEvidenceGrounding": false,
      "validateCanon": true,
      "validateChronology": true,
      "validateCausality": true,
      "validateIdentity": true
    }
  },
